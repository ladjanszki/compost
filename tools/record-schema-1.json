{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ladjanszki/compost/schema/record-1.json",
  "title": "compost record grammar, schema 1",
  "description": "What a single record may be. Graph-level invariants -- parent counts, cycles, the next chain -- are NOT expressible here and live in records.check(). See docs/compost.md.",
  "schema_version": 1,
  "oneOf": [
    {
      "$ref": "#/$defs/node"
    },
    {
      "$ref": "#/$defs/edge"
    }
