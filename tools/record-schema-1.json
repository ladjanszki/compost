      "type": "object",
      "required": [
        "record",
        "guid",
        "type"
      ],
      "properties": {
        "record": {
          "const": "node"
        },
        "guid": {
          "$ref": "#/$defs/guid"
        },
        "schema_version": {
          "type": "integer",
          "minimum": 1
        },
        "type": {
          "enum": [
            "BlockQuote",
            "BulletList",
            "Caption",
            "Cell",
            "CodeBlock",
            "DefinitionItem",
            "DefinitionList",
            "DefinitionTerm",
            "Div",
            "Figure",
