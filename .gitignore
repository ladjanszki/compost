djot/djot-repo*

# Generated runtime data — not source
workspace/

# Python caches
__pycache__/
*.pyc
*.pyo
.pytest_cache/

# Temporary archive — local only
tmp/
.DS_Store
*.egg-info/
build/

# Knowledge base backups — the pre-migration corpus lives in the old repo
_pre-handles-backup/

# Vendored reference: the pandoc AST grammar ground truth. Cloned, not tracked.
#   git clone --depth 1 https://github.com/jgm/pandoc-types.git vendor/pandoc-types
vendor/

# Round-trip test corpus: fetched at the commits pinned in tests/corpus.txt.
#   ./tests/fetch-corpus.sh
tests/corpus/

# This repo's own base. Ignored WHOLE, and deliberately: it holds the human's
# working notes and conversations, and this repository has already had personal
# material purged from its history once. Better never in than removed twice.
#
# No trailing slash. `.compost` here is a symlink into a local-only repo that
# version-controls the base, and git stores a symlink as a blob rather than a
# directory — so `.compost/` would NOT match it and the link would be tracked.
.compost

# secrets
.env
